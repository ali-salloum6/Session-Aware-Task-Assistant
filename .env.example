# OpenRouter + Gemini 2.5 Flash
LLM_API_KEY=sk-or-v1-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash

# Agent loop
MAX_STEPS=8

# Short-term context budget (Phase 3)
MAX_CONTEXT_TOKENS=2000
KEEP_LAST_N_TURNS=4
SUMMARY_TRIGGER_TOKENS=1200
RECALL_K=3
CONTEXT_MODE=bounded

# Long-term memory (Phase 4–5)
MEMORY_DIR=data/memory
DEFAULT_USER_ID=default
LTM_RECALL_K=3
DEDUP_DISTANCE=0.18
REFLECT_MEMORY=1

# Phase 6 — LangGraph
AGENT_MODE=memory
AGENT_BACKEND=graph
CHECKPOINT_PATH=data/checkpoints/langgraph.sqlite

# Phase 7 — Observability (optional Langfuse; local JSON traces always on)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # alias for LANGFUSE_HOST
